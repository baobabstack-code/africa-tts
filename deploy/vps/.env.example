# The domain pointing at this VPS (a DNS A record). Caddy gets its HTTPS certificate.
TTS_DOMAIN=tts.baobabstack.co.zw
# Long random secret; your app sends it as "Authorization: Bearer <key>".
# Generate one with: openssl rand -hex 24
AFRICA_TTS_API_KEY=
# Parallel requests: about one per CPU core, minus one (default 3 for 4 vCPU).
AFRICA_TTS_WORKERS=3
AFRICA_TTS_MAX_CHARS=1000
